# SPEC-019 — spike de la Radio Galega. Copia a spikes/radio/.env.local (ignorado).
# En Vercel, las mismas variables van en el proyecto TEMPORAL (marcador-spike-radio),
# nunca en marcador-gal.

# CA-0.3: la URL exacta del stream escrita en el ledger (oficial de la CRTVG, o la
# pública de listados de terceros con esa anotación). Sin esto nada escucha.
SPIKE_STREAM_URL=

# Secreto de invocación de la función (Authorization: Bearer). Sin él, 401 a todo.
SPIKE_SECRET=

# Store de Blob del proyecto temporal (privado). Lo usan la función y `pull`/`relay`/`purge --blob`.
BLOB_READ_WRITE_TOKEN=

# CA-0.2: `transcribe` y `relay` se niegan a mandar audio a un motor que no esté
# aquí. Solo se escribe DESPUÉS de archivar la copia fechada de su DPA en docs/legal/.
SPIKE_DPA_ACKNOWLEDGED=

# Google Cloud Speech-to-Text v2 (Chirp). Una de las dos credenciales.
GOOGLE_PROJECT_ID=
GOOGLE_STT_LOCATION=europe-west4
GOOGLE_STT_MODEL=chirp_2
GOOGLE_ACCESS_TOKEN=
GOOGLE_API_KEY=

# OpenAI audio/transcriptions.
OPENAI_API_KEY=
OPENAI_ASR_MODEL=gpt-4o-transcribe
