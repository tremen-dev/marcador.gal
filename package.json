{
  "name": "marcador",
  "version": "0.0.1",
  "private": true,
  "description": "Marcador do fútbol galego nunha pantalla — spike de ingesta",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node src/db/cli.ts",
    "test:db": "vitest run --config vitest.integration.config.ts tests/db",
    "test:blob": "vitest run --config vitest.integration.config.ts tests/raw/blob.contract.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "cheerio": "^1.2.0",
    "grammy": "^1.46.0",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "eslint": "^9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
