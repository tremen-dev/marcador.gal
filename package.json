{
  "name": "marcador",
  "version": "0.0.1",
  "private": true,
  "description": "Marcador do fútbol galego nunha pantalla — spike de ingesta",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "gates": "npm run typecheck && npm run lint && npm run build && npm test",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local src/db/cli.ts",
    "calendario:cargar": "node --env-file-if-exists=.env.local src/calendar/cli.ts",
    "alias:cargar": "node --env-file-if-exists=.env.local src/alias/cli.ts",
    "test:db": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts tests/db",
    "test:blob": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts tests/raw/blob.contract.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "mirror:capturar": "node --env-file-if-exists=.env.local src/mirror/cli/capturar-cli.ts",
    "mirror:analizar": "node --env-file-if-exists=.env.local src/mirror/cli/analizar-cli.ts",
    "mirror:analizar-sin-referencia": "node --env-file-if-exists=.env.local src/mirror/cli/analizar-sin-referencia-cli.ts"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "cheerio": "^1.2.0",
    "grammy": "^1.46.0",
    "next": "^16.3.3",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
