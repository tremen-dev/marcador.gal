# Copia este fichero a .env.local y rellena los valores.
# .env.local está en .gitignore: NUNCA se versiona.
# Los scripts lo cargan solos con --env-file-if-exists; no hace falta exportar nada.

# --- Postgres (Neon) -------------------------------------------------------
# Cadena de conexión CON POOLER (la que Neon etiqueta "Pooled connection").
# La usa `npm run db:migrate` para aplicar migrations/*.sql.
DATABASE_URL=

# Cadena de la RAMA DE TEST, desechable. DEBE ser distinta de DATABASE_URL:
# las suites de CA-13..CA-17 escriben y truncan tablas.
# Decisión del gate (2026-08-29): sin esto, esos criterios quedan INCUMPLIDOS,
# no saltados. `npm run test:db` falla con exit 1 a propósito.
DATABASE_URL_TEST=

# --- Vercel Blob -----------------------------------------------------------
# Token de lectura/escritura de un store de Blob. Lo usa la mitad de Blob de
# CA-9. Sin esto, `npm run test:blob` falla con exit 1 a propósito.
BLOB_READ_WRITE_TOKEN=

# --- Telegram: el bot del corresponsal (SPEC-015, ADR-022) -----------------
# Token del bot y secreto del webhook. NO se versionan: van en entorno, sin
# valor aqui. Sin `TELEGRAM_WEBHOOK_SECRET`, el webhook devuelve 401 a todo
# (fallo cerrado, ADR-022 Sec.1).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# El mapeo `telegram_user_id -> correspondent_id`, un objeto JSON
# {"<telegram_user_id>": "corresponsal-01"}.
#
# NUNCA SE VERSIONA, Y ESTA LINEA SE QUEDA SIN VALOR PARA SIEMPRE. Es el mismo
# razonamiento que ADR-009 Sec.3 escribio para el HTML de terceros --git no se
# purga, se reescribe-- aplicado a un dato peor: un identificador personal
# transversal, estable de por vida, en un repositorio PUBLICO. La regla no
# cambia si el repositorio pasa a privado (ADR-022 Sec.2).
#
# Sin esto, el bot no reconoce a nadie: contesta la frase neutra y no recoge
# nada. Es el estado en el que nace.
TELEGRAM_CORRESPONDENTS=

# --- Panel del operador: sesión (SPEC-017, ADR-024) ----------------------------
# Secreto con el que se firman las sesiones del panel. Se usa en HMAC-SHA256 para
# firmar la cookie de sesión, que caduca en 8 horas. Mínimo 32 caracteres.
# Sin esto, el panel rechaza con error específico y ninguna ruta funciona (fallo
# cerrado, ADR-024 §3). Véase `docs/procedimientos/acceso-al-panel-del-operador.md`.
ADMIN_SESSION_SECRET=

# Catálogo de operadores: objeto JSON con operadores declarados.
# Formato: `{"operador-01": "<digest>", "operador-02": "<digest>"}`, donde
# cada valor es el SHA-256 del secreto del operador EN HEXADECIMAL, nunca el
# secreto mismo. El `operator_id` debe casar con `^operador-\d+$`: en un
# repositorio público, cruzado con el calendario declarado, un id con nombre
# identifica a una persona (ADR-024 §2).
#
# NUNCA SE VERSIONA, Y ESTA LINEA SE QUEDA SIN VALOR PARA SIEMPRE. Es el mismo
# razonamiento que ADR-009 §3 escribió para el HTML de terceros —git no se purga,
# se reescribe— aplicado a la credencial de la superficie con peso 1.0.
# `ADMIN_OPERATORS` contiene DIGESTS (SHA-256), no secretos, así que leer la
# variable de producción no abre sesión; quién pueda leerla es una barrera de
# capacidad (CA-1.7, ADR-024 §1).
#
# Sin esto, nadie entra, y el módulo NO lanza error: el panel nace apagado.
# Un panel que revienta al arrancar y uno apagado no pueden confundirse
# (CA-1.2). Véase `docs/procedimientos/acceso-al-panel-del-operador.md`.
ADMIN_OPERATORS=
