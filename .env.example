# Copia este fichero a .env.local y rellena los valores.
# .env.local está en .gitignore: NUNCA se versiona.
# Los scripts lo cargan solos con --env-file-if-exists; no hace falta exportar nada.

# --- Postgres (Neon) -------------------------------------------------------
# Cadena de conexión CON POOLER (la que Neon etiqueta "Pooled connection").
# La usa `npm run db:migrate` para aplicar migrations/*.sql.
DATABASE_URL=

# Cadena de la RAMA DE TEST, desechable. DEBE ser distinta de DATABASE_URL:
# las suites de CA-13..CA-17 escriben y truncan tablas.
# Decisión del gate (2026-08-29): sin esto, esos criterios quedan INCUMPLIDOS,
# no saltados. `npm run test:db` falla con exit 1 a propósito.
DATABASE_URL_TEST=

# --- Vercel Blob -----------------------------------------------------------
# Token de lectura/escritura de un store de Blob. Lo usa la mitad de Blob de
# CA-9. Sin esto, `npm run test:blob` falla con exit 1 a propósito.
BLOB_READ_WRITE_TOKEN=
